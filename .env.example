# Copy to .env for local dev. In production set these in Vercel > Project > Settings > Environment Variables.
# Secret key from the downtowndigitalden Stripe account (Developers > API keys). Use sk_test_... until launch.
STRIPE_SECRET_KEY=sk_test_replace_me
# Public URL of the site, used for Stripe redirect URLs. Optional on Vercel (falls back to the request host).
SITE_URL=http://localhost:3000
