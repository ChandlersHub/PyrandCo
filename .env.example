# Copy to .env for local dev. In production set these in Vercel > Project > Settings > Environment Variables.

# Stripe (downtowndigitalden account). Use sk_test_... until launch.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret of the webhook endpoint https://pyrandco.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Printful private token (Developers > Your tokens). Orders arrive as drafts.
PRINTFUL_API_KEY=
# Only needed if the token covers more than one Printful store.
PRINTFUL_STORE_ID=
# Set to true to send orders straight to production instead of drafts.
PRINTFUL_CONFIRM_ORDERS=false

# Public URL of the site, used for Stripe redirects and Printful print files.
SITE_URL=http://localhost:3000
